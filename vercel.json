{
  "version": 2,
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/proxy?path=$1"
    },
    {
      "src": "/api/analyze",
      "methods": ["POST", "OPTIONS"],
      "dest": "/api/analyze.js"
    }
  ],
  "functions": {
    "api/analyze.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/proxy.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
